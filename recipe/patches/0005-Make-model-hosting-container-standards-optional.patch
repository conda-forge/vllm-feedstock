From: "Uwe L. Korn" <uwe.korn@quantco.com>
Date: Thu, 25 Jun 2026 10:28:17 +0200
Subject: [PATCH 5/9] Make model hosting container standards optional

---
 vllm/entrypoints/serve/lora/api_router.py      | 13 ++++++++++++-
 vllm/entrypoints/serve/sagemaker/api_router.py | 24 +++++++++++++++++++++---
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/vllm/entrypoints/serve/lora/api_router.py b/vllm/entrypoints/serve/lora/api_router.py
index 6143637..17afd25 100644
--- a/vllm/entrypoints/serve/lora/api_router.py
+++ b/vllm/entrypoints/serve/lora/api_router.py
@@ -50,7 +50,18 @@ def attach_router(app: FastAPI):

 def _attach_router(app: FastAPI):
     """Register the LoRA adapter load/unload routes on the app."""
-    import model_hosting_container_standards.sagemaker as sagemaker_standards
+    try:
+        import model_hosting_container_standards.sagemaker as sagemaker_standards
+    except ImportError:
+
+        class _Stub:
+            def register_load_adapter_handler(self, **kwargs):
+                return lambda fn: fn
+
+            def register_unload_adapter_handler(self, **kwargs):
+                return lambda fn: fn
+
+        sagemaker_standards = _Stub()

     @sagemaker_standards.register_load_adapter_handler(
         request_shape={
diff --git a/vllm/entrypoints/serve/sagemaker/api_router.py b/vllm/entrypoints/serve/sagemaker/api_router.py
index f2fb255..c255846 100644
--- a/vllm/entrypoints/serve/sagemaker/api_router.py
+++ b/vllm/entrypoints/serve/sagemaker/api_router.py
@@ -74,7 +74,24 @@ def _attach_router(
 ):
     """Register the SageMaker hosting routes (/ping, /invocations) on the
     app."""
-    import model_hosting_container_standards.sagemaker as sagemaker_standards
+    try:
+        import model_hosting_container_standards.sagemaker as sagemaker_standards
+    except ImportError:
+
+        class _Stub:
+            def register_ping_handler(self, fn):
+                return fn
+
+            def register_invocation_handler(self, fn):
+                return fn
+
+            def stateful_session_manager(self):
+                return lambda fn: fn
+
+            def inject_adapter_id(self, **kwargs):
+                return lambda fn: fn
+
+        sagemaker_standards = _Stub()

     router = APIRouter()

@@ -151,7 +168,10 @@ def sagemaker_standards_bootstrap(app: FastAPI) -> FastAPI:
     """
     snapshot = _snapshot_handler_levels()
     try:
-        import model_hosting_container_standards.sagemaker as sagemaker_standards
+        try:
+            import model_hosting_container_standards.sagemaker as sagemaker_standards
+        except ImportError:
+            return app

         app = sagemaker_standards.bootstrap(app)
     finally:
